GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# 4 caused severe gateway queueing under 50-client load (46/50 requests stacked).
# 16 handles natural staggering of distinct-audio sessions without GPU saturation.
GATEWAY_MAX_INFLIGHT_WORKER=16
# Must exceed ASR_INFERENCE_TIMEOUT_MS + audio-preprocessing overhead (~3 s).
WORKER_TIMEOUT_MS=15000
WORKER_URL=http://worker:9000
GATEWAY_WS_PING_INTERVAL=120
GATEWAY_WS_PING_TIMEOUT=120
# 900 ms added up to ~900 ms jitter in partial-result delivery; 500 ms reduces perceived latency.
PARTIAL_DECODE_INTERVAL_MS=500
STREAMING_RING_BUFFER_MS=600
STREAMING_VAD_MODE=3
STREAMING_GATE_OPEN_WINDOW_FRAMES=3
STREAMING_GATE_OPEN_REQUIRED_VOICED_FRAMES=2
STREAMING_GATE_CLOSE_WINDOW_FRAMES=5
STREAMING_GATE_CLOSE_REQUIRED_UNVOICED_FRAMES=4
STREAMING_HANGOVER_MS=200
SPEAKER_VERIFICATION_MODE=disabled
SPEAKER_VERIFICATION_BACKEND=external
SPEAKER_VERIFICATION_THRESHOLD=0.70
SPEAKER_VERIFICATION_FIRST_DECISION_MS=360
SPEAKER_VERIFICATION_RESCORE_MS=200
SPEAKER_VERIFICATION_ENROLLED_EMBEDDING_PATH=
SPEAKER_VERIFICATION_DEBUG_SIMILARITY=0.95

LOG_LEVEL=INFO
LOG_TRANSCRIPTS=false
WS_API_KEYS=dev
VITE_DEBUG_LOGS=true
EVAL_LOGS_ENABLED=false
EVAL_LOG_SAMPLE_RATE=1.0
EVAL_LOG_TEXT_PREVIEW_CHARS=16

ASR_MODEL_NAME=ai4bharat/indic-conformer-600m-multilingual
ASR_BACKEND=local
ASR_DECODER=rnnt
# 4000 ms caused fallback_timeout when post-flush p99 reached 4.27 s at 50-client load.
# 8000 ms gives 2× headroom above the observed worst-case while still bounding stuck jobs.
ASR_INFERENCE_TIMEOUT_MS=8000
ASR_DEFAULT_LANGUAGE=hi
ASR_SUPPORTED_LANGS=
ASR_TRITON_PROTOCOL=grpc
TRITON_URL=triton:8001
TRITON_MODEL_NAME=indic_asr
TRITON_MODEL_VERSION=
# Optional native CTC ensemble (preproc + encoder + ctc_decoder). When set, the
# Triton worker routes `decoding=ctc` requests through this ensemble. RNNT keeps
# using TRITON_MODEL_NAME, whose Python backend now BLS-calls the shared
# indic_asr_encoder model so RNNT can still reuse the TensorRT encoder.
# Empty keeps serving RNNT only.
TRITON_MODEL_NAME_CTC=
TRITON_MODEL_VERSION_CTC=
ASR_TRITON_CIRCUIT_BREAKER_ENABLED=true
ASR_TRITON_CIRCUIT_FAILURE_THRESHOLD=3
ASR_TRITON_CIRCUIT_RECOVERY_TIMEOUT_SEC=30
ASR_TRITON_CIRCUIT_HALF_OPEN_SUCCESS_THRESHOLD=1
ASR_TRITON_READY_RETRY_ATTEMPTS=20
ASR_TRITON_READY_RETRY_INITIAL_DELAY_SEC=2
ASR_TRITON_READY_RETRY_MAX_DELAY_SEC=5
TRITON_SERVER_IMAGE=nvcr.io/nvidia/tritonserver:24.09-py3
TRITON_FRAME_DURATION_MS=0.08
ASR_ENABLE_LID=false
# Legacy single-provider config remains supported if the new chain vars are unset.
ASR_LID_MODEL_SOURCE=speechbrain/lang-id-voxlingua107-ecapa
ASR_LID_MODEL_DIR=models/lid_model
ASR_LID_PRIMARY_PROVIDER=vakgyata
ASR_LID_PRIMARY_SOURCE=onecxi/vakgyata-small
ASR_LID_PRIMARY_MODEL_DIR=models/lid_primary
ASR_LID_FALLBACK_PROVIDER=speechbrain
ASR_LID_FALLBACK_SOURCE=speechbrain/lang-id-voxlingua107-ecapa
ASR_LID_FALLBACK_MODEL_DIR=models/lid_fallback
ASR_LID_CONFIDENCE_THRESHOLD=0.70
ASR_LID_CACHE_TTL_SEC=600
ASR_LID_CACHE_MAX_ENTRIES=10000
ASR_CONTEXT_BIASING_MODE=disabled
ASR_CONTEXT_BIASING_METHOD=ctc_ws
ASR_CONTEXT_BIASING_NEMO_SOURCE=
ASR_CONTEXT_BIASING_NEMO_MODEL_CLASS=
ASR_CONTEXT_BIASING_PHRASES_DIR=
ASR_CONTEXT_BIASING_TIMEOUT_MS=4000
ASR_CONTEXT_BIASING_DEVICE=cuda
ASR_CONTEXT_BIASING_SHADOW_SAMPLE_RATE=1.0
ASR_CONTEXT_BIASING_BEAM_THRESHOLD=8.0
ASR_CONTEXT_BIASING_CONTEXT_SCORE=3.0
ASR_CONTEXT_BIASING_CTC_ALI_TOKEN_WEIGHT=0.6
ASR_CONTEXT_BIASING_DYNAMIC_MAX_PHRASES=32
# 2 concurrent ASR jobs serialized heavily under any real concurrency.
# 8 matches observed GPU parallelism without saturating Triton queue depth.
WORKER_MAX_JOBS=8
DENOISER=deepfilternet
HUGGINGFACE_HUB_TOKEN=
HF_HOME=
