name: "indic_asr_rnnt"
backend: "python"
max_batch_size: 0
input [
  { name: "AUDIO_SIGNAL"  data_type: TYPE_FP32   dims: [-1, -1] },
  { name: "LENGTH"        data_type: TYPE_INT64  dims: [-1] },
  { name: "LANGUAGE"      data_type: TYPE_STRING dims: [1] }
]
output [
  { name: "TOKENS"        data_type: TYPE_INT32  dims: [-1, -1] },
  { name: "TOKEN_COUNT"   data_type: TYPE_INT64  dims: [-1] }
]
instance_group [{ kind: KIND_CPU count: 2 }]
