# Ensemble: AUDIO_SIGNAL + LENGTH -> log-mel preprocessor -> encoder -> CTC head.
# Returns raw (unmasked) log-probs and encoded frame lengths. The worker applies
# the language-specific token mask, argmax, dedup and vocab lookup; this avoids
# pulling per-language vocab/mask state into Triton.
#
# IMPORTANT: this ensemble does NOT cover the RNNT path. RNNT continues to be
# served by the `indic_asr` python backend until Phase 2.

name: "indic_asr_ctc"
platform: "ensemble"
max_batch_size: 0

input [
  {
    name: "AUDIO_SIGNAL"
    data_type: TYPE_FP32
    dims: [-1, -1]
  },
  {
    name: "LENGTH"
    data_type: TYPE_INT64
    dims: [-1]
  }
]

output [
  {
    name: "LOGPROBS"
    data_type: TYPE_FP32
    dims: [-1, -1, 5633]
  },
  {
    name: "ENCODED_LENGTHS"
    data_type: TYPE_INT64
    dims: [-1]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "indic_asr_preproc"
      model_version: -1
      input_map {
        key: "INPUT__0"
        value: "AUDIO_SIGNAL"
      }
      input_map {
        key: "INPUT__1"
        value: "LENGTH"
      }
      output_map {
        key: "OUTPUT__0"
        value: "preproc_audio_signal"
      }
      output_map {
        key: "OUTPUT__1"
        value: "preproc_length"
      }
    },
    {
      model_name: "indic_asr_encoder"
      model_version: -1
      input_map {
        key: "audio_signal"
        value: "preproc_audio_signal"
      }
      input_map {
        key: "length"
        value: "preproc_length"
      }
      output_map {
        key: "outputs"
        value: "encoder_outputs"
      }
      output_map {
        key: "encoded_lengths"
        value: "ENCODED_LENGTHS"
      }
    },
    {
      model_name: "indic_asr_ctc_decoder"
      model_version: -1
      input_map {
        key: "encoder_output"
        value: "encoder_outputs"
      }
      output_map {
        key: "logprobs"
        value: "LOGPROBS"
      }
    }
  ]
}
