name: "indic_asr_rnnt_joint"
backend: "onnxruntime"
max_batch_size: 0
input [
  { name: "encoder_frame"  data_type: TYPE_FP32 dims: [-1, 1, 1024] },
  { name: "predictor_out"  data_type: TYPE_FP32 dims: [-1, 1, 640] }
]
output [
  { name: "logits"         data_type: TYPE_FP32 dims: [-1, 1, 1, 5633] }
]
instance_group [{ kind: KIND_GPU count: 1 }]
