# IndicConformer encoder served directly from ONNX Runtime.
#
# This deployment intentionally loads `model.onnx`, not a TensorRT `model.plan`.
# Keep the encoder ONNX plus its external weight blobs (`layers.*`,
# `Constant_*`, `onnx__*`, `pre*`) together in this version directory; the ONNX
# graph references those files by name.
#
# A TensorRT plan can still be built experimentally from this ONNX export, but
# it is not required for the current serving path. Do not switch this model back
# to `backend: "tensorrt"` without a transcript parity pass; an earlier FP16 TRT
# plan loaded successfully but produced blank RNNT and CTC transcripts.

name: "indic_asr_encoder"
backend: "tensorrt"
default_model_filename: "model.plan"
max_batch_size: 0

input [
  {
    name: "audio_signal"
    data_type: TYPE_FP32
    dims: [-1, 80, -1]
  },
  {
    name: "length"
    data_type: TYPE_INT64
    dims: [-1]
  }
]

output [
  {
    name: "outputs"
    data_type: TYPE_FP32
    dims: [-1, 1024, -1]
  },
  {
    name: "encoded_lengths"
    data_type: TYPE_INT64
    dims: [-1]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

