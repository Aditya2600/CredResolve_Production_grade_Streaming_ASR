# IndicConformer encoder served through TensorRT.
#
# The model.plan is built inside the Triton+TRT container against the actual
# production GPU with the parity-safe FP32 baseline:
#   trtexec --onnx=/models/indic_asr_encoder/1/model.onnx \
#     --noTF32 \
#     --minShapes=audio_signal:1x80x100,length:1 \
#     --optShapes=audio_signal:1x80x800,length:1 \
#     --maxShapes=audio_signal:1x80x3000,length:1 \
#     --memPoolSize=workspace:4096 \
#     --saveEngine=/models/indic_asr_encoder/1/model.plan
#
# Do not replace this baseline with an FP16 engine without a real transcript
# parity pass. On 2026-05-15, the FP16 plan loaded successfully but compressed
# encoder activations enough that both RNNT and CTC returned blank transcripts.
# `model.onnx` remains beside the plan for an immediate ORT rollback path.
#
# Encoder ONNX + external weight blobs (`layers.*`, `Constant_*`, `onnx__*`,
# `pre*`) must remain alongside model.plan — Triton TRT backend will pick the
# .plan, but a future re-build of the engine reads from model.onnx.

name: "indic_asr_encoder"
backend: "tensorrt"
default_model_filename: "model.plan"
max_batch_size: 0

input [
  {
    name: "audio_signal"
    data_type: TYPE_FP32
    dims: [-1, 80, -1]
  },
  {
    name: "length"
    data_type: TYPE_INT64
    dims: [-1]
  }
]

output [
  {
    name: "outputs"
    data_type: TYPE_FP32
    dims: [-1, 1024, -1]
  },
  {
    name: "encoded_lengths"
    data_type: TYPE_INT64
    dims: [-1]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

