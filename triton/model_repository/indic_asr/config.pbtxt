name: "indic_asr"
backend: "python"
max_batch_size: 0

input [
  {
    name: "AUDIO_SIGNAL"
    data_type: TYPE_FP32
    dims: [1, -1]
  },
  {
    name: "LANGUAGE"
    data_type: TYPE_STRING
    dims: [1]
  },
  {
    name: "DECODER"
    data_type: TYPE_STRING
    dims: [1]
  }
]

output [
  {
    name: "TRANSCRIPT"
    data_type: TYPE_STRING
    dims: [1]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]
